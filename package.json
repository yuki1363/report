{
  "name": "insulation-report",
  "version": "0.1.0",
  "private": true,
  "description": "配電盤 絶縁抵抗測定報告書アプリ（ローカル起動）",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "concurrently -n server,client \"tsx watch src/server/main.ts --no-open\" \"vite\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "gen:template": "tsx scripts/build-default-template.ts",
    "package:win": "node scripts/package-win.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@hono/node-server": "^2.1.6",
    "@tesseract.js-data/jpn": "^1.0.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "hono": "^4.13.16",
    "pdfjs-dist": "^6.5.438",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "adm-zip": "^0.6.1",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
