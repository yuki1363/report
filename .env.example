# .env にコピーして使用（.env は Git にコミットしない）
# Claude API キー（P2 の読み取り機能で使用。サーバー側だけで使う）
ANTHROPIC_API_KEY=
# 読み取りに使うモデル名（既定は Sonnet 系）
CLAUDE_MODEL=claude-sonnet-5-5
# サーバーのポート（localhost のみで待ち受け）
PORT=8787
# PDF 出力に使うブラウザ: msedge（既定）/ chrome / 実行ファイルのフルパス
PDF_BROWSER=msedge
# データ保存先（SQLite・画像）
DATA_DIR=./data
